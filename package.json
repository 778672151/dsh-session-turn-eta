{
  "name": "@dsh-external/dsh-session-turn-eta",
  "version": "0.4.1",
  "description": "Predicts the remaining wall time of the live DeepSeek Harness turn from its step history and shows it as a progress bar with a live percentage under the composer.",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "progress",
    "eta",
    "ui"
  ],
  "scripts": {
    "build": "tsdown",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node test/smoke.mjs && node test/predict.mjs && node test/fold.mjs && node test/equiv.mjs",
    "test:render": "node test/render-real.mjs",
    "test:equiv": "node test/equiv.mjs",
    "bench": "node bench/bench.mjs",
    "test:skin": "node test/skin.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
